// app.js (300問最適化：分割ロード + キャッシュ + 正解追従シャッフル)

const QUESTION_COUNT = 10; // 1回の出題数（必要なら設定画面と連動）

// ---- DOM ----
const homeSection = document.getElementById("home");
const quizSection = document.getElementById("quiz");
const resultSection = document.getElementById("result");

const startBtn = document.getElementById("startBtn");
const reviewBtn = document.getElementById("reviewBtn");

const progressEl = document.getElementById("progress");
const modeLabelEl = document.getElementById("modeLabel");
const questionEl = document.getElementById("question");
const choicesEl = document.getElementById("choices");
const feedbackEl = document.getElementById("feedback");
const nextBtn = document.getElementById("nextBtn");

const scoreEl = document.getElementById("score");
const rateEl = document.getElementById("rate");
const wrongCountEl = document.getElementById("wrongCount");
const backBtn = document.getElementById("backBtn");

const homeMessageEl = document.getElementById("homeMessage");

// ---- Settings (あなたのUI側の難易度選択に合わせてここだけ連動させればOK) ----
let selectedDifficulty = "normal"; // easy / normal / hard / mania
let mode = "normal"; // normal / review

// ---- State ----
let allQuestions = [];
let sessionQuestions = [];
let index = 0;
let score = 0;
let wrongIds = []; // review用
let locked = false;

// ---- Util ----
function $(id) { return document.getElementById(id); }

function show(section) {
  homeSection.classList.add("hidden");
  quizSection.classList.add("hidden");
  resultSection.classList.add("hidden");
  section.classList.remove("hidden");
}

function fisherYatesShuffle(arr) {
  // in-place
  for (let i = arr.length - 1; i > 0; i--) {
    const j = (Math.random() * (i + 1)) | 0;
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

// choices をシャッフルしつつ、answerIndexを追従させる
function shuffleChoicesKeepAnswer(q) {
  const items = q.choices.map((text, i) => ({ text, i }));
  fisherYatesShuffle(items);
  const newChoices = items.map(x => x.text);
  const newAnswerIndex = items.findIndex(x => x.i === q.answerIndex);
  return { ...q, choices: newChoices, answerIndex: newAnswerIndex };
}

// ---- Data loading ----
function fileForDifficulty(d) {
  // ファイル分割する前提（分割しない場合は questions.json に戻してOK）
  switch (d) {
    case "easy": return "questions_easy.json";
    case "normal": return "questions_normal.json";
    case "hard": return "questions_hard.json";
    case "mania": return "questions_mania.json";
    default: return "questions_normal.json";
  }
}

function cacheKey(d) {
  return `sengoku_questions_${d}_v1`; // v1 を上げれば強制更新
}

async function loadQuestionsByDifficulty(d) {
  const key = cacheKey(d);
  const cached = localStorage.getItem(key);
  if (cached) {
    try {
      return JSON.parse(cached);
    } catch (_) {
      localStorage.removeItem(key);
    }
  }

  const filename = fileForDifficulty(d);
  const res = await fetch(filename, { cache: "no-store" });
  if (!res.ok) throw new Error(`Failed to load ${filename}`);
  const data = await res.json();

  // 保存（2回目以降爆速）
  try {
    localStorage.setItem(key, JSON.stringify(data));
  } catch (_) {
    // 容量不足なら無視（動作はする）
  }
  return data;
}

// ---- Session building ----
function buildSessionQuestions(source, count, isReview) {
  let pool = source.slice();

  if (isReview) {
    // 間違えたIDだけ
    const set = new Set(wrongIds);
    pool = pool.filter(q => set.has(q.id));
  }

  fisherYatesShuffle(pool);

  // 必要数だけ取り、choicesもシャッフル（正解追従）
  return pool
    .slice(0, Math.min(count, pool.length))
    .map(shuffleChoicesKeepAnswer);
}

// ---- Quiz flow ----
function renderQuestion() {
  locked = false;
  feedbackEl.innerHTML = "";
  nextBtn.classList.add("hidden");

  const q = sessionQuestions[index];
  progressEl.textContent = `${index + 1} / ${sessionQuestions.length}`;
  modeLabelEl.textContent = mode === "review" ? "復習" : "通常";

  questionEl.textContent = q.question;

  choicesEl.innerHTML = "";
  q.choices.forEach((c, i) => {
    const btn = document.createElement("button");
    btn.className = "choice"; // CSSで整える
    btn.type = "button";
    btn.innerHTML = `<span class="opt">${String.fromCharCode(65 + i)}</span><span class="txt">${escapeHtml(c)}</span>`;
    btn.addEventListener("click", () => onAnswer(i));
    choicesEl.appendChild(btn);
  });
}

function onAnswer(selectedIndex) {
  if (locked) return;
  locked = true;

  const q = sessionQuestions[index];
  const isCorrect = selectedIndex === q.answerIndex;

  // 表示：正誤 + 解説
  if (isCorrect) {
    score++;
    feedbackEl.innerHTML = `
      <div class="judge ok">正解</div>
      <div class="kaisetsu">
        <div class="kaisetutitle">軍議</div>
        <div class="kaisetsu-body">${escapeHtml(q.explanation || "解説なし")}</div>
      </div>
    `;
  } else {
    wrongIds.push(q.id);
    const correctText = q.choices[q.answerIndex];
    feedbackEl.innerHTML = `
      <div class="judge ng">不正解</div>
      <div class="answerline">正解：${escapeHtml(correctText)}</div>
      <div class="kaisetsu">
        <div class="kaisetutitle">軍議</div>
        <div class="kaisetsu-body">${escapeHtml(q.explanation || "解説なし")}</div>
      </div>
    `;
  }

  nextBtn.classList.remove("hidden");
}

function finish() {
  show(resultSection);
  const total = sessionQuestions.length;
  const rate = total ? Math.round((score / total) * 100) : 0;

  scoreEl.textContent = `正解数：${score} / ${total}`;
  rateEl.textContent = `正答率：${rate}%`;
  wrongCountEl.textContent = `誤答：${wrongIds.length}`;

  // 復習ボタン活性（間違いがある時だけ）
  reviewBtn.disabled = wrongIds.length === 0;
}

function escapeHtml(s) {
  return String(s ?? "")
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

// ---- Start / Review ----
async function startQuiz(isReview) {
  try {
    homeMessageEl.textContent = "読み込み中…";

    allQuestions = await loadQuestionsByDifficulty(selectedDifficulty);

    mode = isReview ? "review" : "normal";
    score = 0;
    index = 0;

    sessionQuestions = buildSessionQuestions(allQuestions, QUESTION_COUNT, isReview);

    if (!sessionQuestions.length) {
      homeMessageEl.textContent = isReview
        ? "復習する問題がありません（誤答が0件）"
        : "問題データがありません";
      return;
    }

    show(quizSection);
    renderQuestion();
  } catch (e) {
    console.error(e);
    homeMessageEl.textContent = `読み込み失敗：${e.message}`;
  }
}

// ---- Events ----
startBtn.addEventListener("click", () => startQuiz(false));
reviewBtn.addEventListener("click", () => startQuiz(true));

nextBtn.addEventListener("click", () => {
  if (index < sessionQuestions.length - 1) {
    index++;
    renderQuestion();
  } else {
    finish();
  }
});

backBtn.addEventListener("click", () => {
  show(homeSection);
  homeMessageEl.textContent = "";
});

// 初期
show(homeSection);
homeMessageEl.textContent = "難易度を選んで開始してください。";
reviewBtn.disabled = true;
